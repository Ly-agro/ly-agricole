# Jeton partagé avec la plateforme (IA_JETON dans le .env de Laravel). Obligatoire :
# sans lui, le service refuse tout. Générer : python -c "import secrets; print(secrets.token_urlsafe(32))"
IA_JETON=

# « ollama » sur le serveur ; « faux » pour un essai sans modèle.
IA_LLM=ollama
# VPS sans carte graphique : un petit modèle (3 milliards de paramètres) ; avec une carte
# NVIDIA 12 Go : qwen2.5:7b-instruct.
OLLAMA_MODELE=qwen2.5:3b-instruct
# Sans carte graphique, une réponse peut prendre une à plusieurs minutes.
IA_DELAI_SECONDES=300

# Modèle de vision entraîné (ONNX, dans ./modeles). Vide : tout diagnostic est « incertain ».
IA_MODELE_VISION=
# Sous ce seuil (pour mille), le diagnostic est « incertain » et part à un humain.
IA_SEUIL_CONFIANCE=850

# Adresse d'écoute : 127.0.0.1 si la plateforme est sur le même VPS, sinon l'adresse du VPN
# (WireGuard, ex. 10.8.0.2). Jamais 0.0.0.0 : le service ne s'ouvre pas à Internet.
IA_ECOUTE=127.0.0.1
